    {
      "parameters": {
        "jsCode": "const topics = $input.first().json.output.topics || [];\nconst stamp = $now.toFormat('yyyy-MM-dd-HHmm');\n\nreturn topics\n  .map(t => ({ ...t, total_score: (Number(t.fit_score) || 0) + (Number(t.opportunity_score) || 0) }))\n  .sort((a, b) => b.total_score - a.total_score)\n  .slice(0, 5)\n  .map((t, i) => ({ json: { id: `${stamp}_${i + 1}`, date: stamp, rank: i + 1, ...t, status: 'suggested' } }));"
      },
