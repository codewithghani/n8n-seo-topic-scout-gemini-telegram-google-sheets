    {
      "parameters": {
        "jsCode": "const seeds = $('Get Seeds').all()\n  .map(i => `${i.json.Theme}: ${i.json.seed_keyword}`).join('\\n');\n\nconst autocomplete = $('Collect autocomplete').first().json.autocomplete;\n\nconst reddit = $('Merge Reddit').all()\n  .filter(i => i.json.title)\n  .slice(0, 30)\n  .map(i => `- ${i.json.title}`).join('\\n');\n\nconst existing = $('Get existing post').all()\n  .map(i => i.json.title).filter(Boolean).join('\\n') || '(none yet)';\n\nreturn [{ json: { seeds, autocomplete, reddit, existing } }];"
      },
      "id": "604c2e34-bdd6-4569-bad3-41b3879315bc",
      "name": "Build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
