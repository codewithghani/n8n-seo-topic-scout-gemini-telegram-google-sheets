        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  try {\n    const parsed = JSON.parse(item.json.data);\n    for (const s of (parsed[1] || [])) out.push(s);\n  } catch (e) {}\n}\nconst unique = [...new Set(out)];\nreturn [{ json: { autocomplete: unique.join('\\n'), count: unique.length } }];"
