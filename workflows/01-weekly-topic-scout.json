    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst cap = s => { const v = String(s ?? '').trim(); return v ? v.charAt(0).toUpperCase() + v.slice(1) : '-'; };\nconst topics = $('Pick top 5').all().map(i => i.json);\nconst date = topics[0]?.date || '';\nconst line = '\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500';\n\nconst parts = [];\nparts.push('<b>Lyra FinX \u00b7 Weekly topic picks</b>');\nparts.push('<i>' + esc(date) + ' \u00b7 ' + topics.length + ' ideas, best first</i>');\nparts.push(line);\n\nfor (const t of topics) {\n  parts.push('<b>' + t.rank + ') ' + esc(t.title) + '</b>');\n  parts.push('Score <b>' + t.total_score + '/20</b> \u00b7 ' + esc(cap(t.difficulty_guess)) + ' \u00b7 ' + esc(cap(t.search_intent)));\n  parts.push('Keyword: <code>' + esc(t.primary_keyword) + '</code>');\n  parts.push('Angle: ' + esc(t.angle));\n  parts.push('Why: ' + esc(t.why));\n  parts.push(line);\n}\n\nparts.push('<b>How to reply</b>');\nparts.push('\u2022 Reply with the numbers to write, e.g. <code>1 3</code>');\nparts.push('\u2022 Reply <code>all</code> to approve every topic');\nparts.push('\u2022 Reply <code>none</code> to skip this week');\nparts.push('');\nparts.push('<i>Difficulty is an AI estimate, not measured data.</i>');\n\nreturn [{ json: { text: parts.join('\\n'), date } }];"
      },
